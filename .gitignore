# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Build
dist/
build/
# spec-файлы сборки намеренно отслеживаются в packaging/ — игнорируем только
# случайно созданные в корне (PyInstaller кладёт .spec рядом с .spec-файлом
# при запуске без указания каталога).
/*.spec
*.egg-info/
*.egg

# VCS
.git/

# Logs
*.log

# Артефакты локальных запусков (пустые логи из консоли/редиректа)
err.txt
error.txt
out.txt
gui-stdout.txt
gui-stderr.txt

# Собранные exe в корне (штатные сборки лежат в ignored-каталоге dist/)
/*.exe

# Environment
.env
.venv
venv/

# PyInstaller
runtime.txt

# OS
.DS_Store
Thumbs.db

# coverage
.coverage
htmlcov/
coverage.xml

# Локальная память агента (XMemo-шаблон) — утилита для ИИ-ассистентов,
# не часть кодовой базы ArcTune; данные и CLI живут только локально.
/mem.py
/memory/
# embedding-сервер для mem.py (вектора + remote-каскад): скрипты и локальный
# config.bat с путями машины; к проекту ArcTune отношения не имеет.
/SERVER/
# контракт модели памяти MEM (типы/frontmatter/статусы) — дока утилиты агента.
/DESIGN.md
